{
  "name": "hurtmusic",
  "version": "1.1.0",
  "description": "Native standalone player for hurtmusic offline & online",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack:zip": "node build-zip.js"
  },
  "keywords": [
    "music-player",
    "hurtmusic",
    "electron",
    "offline"
  ],
  "author": "hurtmusic",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "com.hurtmusic.desktop",
    "productName": "hurtmusic",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!tiktok_video/**",
      "!downloads/**",
      "!*.md"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "hls.js": "^1.7.4"
  }
}
